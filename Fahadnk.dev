#include <iostream>
#include <string>
using namespace std;

// Base Class
class Cafe
{
protected:
    string itemName[5] = {"Burger", "Pizza", "Coffee", "Sandwich", "Fries"};
    int itemPrice[5] = {500, 1200, 250, 400, 300};

public:
    // Function to display menu
    void showMenu()
    {
        cout << "\n========= CAFE MENU =========\n";
        for (int i = 0; i < 5; i++)
        {
            cout << i + 1 << ". " << itemName[i]
                 << " - Rs. " << itemPrice[i] << endl;
        }
        cout << "=============================\n";
    }
};

// Derived Class
class Order : public Cafe
{
private:
    int totalBill = 0;

public:
    // Function for taking order
    void takeOrder()
    {
        int choice, quantity;
        char more;

        do
        {
            showMenu();

            cout << "\nEnter item number: ";
            cin >> choice;

            cout << "Enter quantity: ";
            cin >> quantity;

            // Validation
            if (choice >= 1 && choice <= 5)
            {
                int cost = itemPrice[choice - 1] * quantity;

                cout << "\nYou ordered: "
                     << itemName[choice - 1]
                     << " x " << quantity << endl;

                cout << "Cost = Rs. " << cost << endl;

                totalBill += cost;
            }
            else
            {
                cout << "\nInvalid Choice!\n";
            }

            cout << "\nDo you want to order more? (y/n): ";
            cin >> more;

        } while (more == 'y' || more == 'Y');

        generateBill();
    }

    // Polymorphism (Virtual Function)
    virtual void generateBill()
    {
        cout << "\n========== FINAL BILL ==========\n";
        cout << "Total Amount = Rs. " << totalBill << endl;
        cout << "Thank You For Visiting Our Cafe!\n";
        cout << "================================\n";
    }
};

// Main Function
int main()
{
    Order customer;

    cout << "WELCOME TO CAFE MANAGEMENT SYSTEM\n";

    customer.takeOrder();

    return 0;
}
